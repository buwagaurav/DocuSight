# ---- LLM provider (AI extraction + chat) --------------------------------------
# Model spec is "provider:model". Providers: anthropic | deepseek
#   anthropic:claude-opus-5-5   (needs ANTHROPIC_API_KEY)
#   deepseek:deepseek-flash     (DeepSeek V4.1 Flash, vision; needs DEEPSEEK_API_KEY)
#   deepseek:deepseek-v4-pro    (text only: page images/charts are not seen)
LLM_MODEL=anthropic:claude-opus-5-5
# FAST_MODEL=claude-haiku-5-5      # contextual retrieval model (defaults: Haiku for anthropic, same model for deepseek)

ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...

# ---- ColPali visual retrieval -----------------------------------------------
# auto = on when torch + colpali-engine are installed (pip install -r backend/requirements-colpali.txt)
COLPALI_ENABLED=auto
# vidore/colpali-v1.3 (~6 GB, best-known), vidore/colqwen2.5-v0.2 (strong), vidore/colSmol-500M (light, laptops)
COLPALI_MODEL=vidore/colpali-v1.3

# ---- Retrieval tuning ---------------------------------------------------------
# Dense embeddings: google/embeddinggemma-2 (sentence-transformers, 8K ctx, Matryoshka)
# or any fastembed model, e.g. BAAI/bge-small-en-v1.5 (fast, 384d)
EMBED_MODEL=google/embeddinggemma-2
EMBED_DIM=768                      # 768 | 512 | 256 | 128 (Matryoshka truncation)
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_ENABLED=true
CONTEXTUAL_RETRIEVAL=false         # LLM-written context per chunk before indexing (extra API cost)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
SEMANTIC_CACHE_THRESHOLD=0.97
